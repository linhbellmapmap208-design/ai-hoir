# Base44 development image for the TransKun piano-transcription API.
#
# Only runtime dependencies are installed here - the application source is
# bind-mounted into the running container, so code edits never need a rebuild.
# Rebuild only when requirements.txt changes.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# ffmpeg + libsndfile decode the uploaded audio, sox/ libsoxr back the
# pydub / sox / soxr packages that transkun depends on.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libsndfile1 \
        sox \
        libsox-fmt-all \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./

# CPU-only torch first, so transkun's unpinned torch/torchaudio dependencies
# are already satisfied and no CUDA wheels get pulled in.
RUN pip install torch torchaudio --index-url https://download.pytorch.org/whl/cpu \
 && pip install -r requirements.txt

EXPOSE 3000
